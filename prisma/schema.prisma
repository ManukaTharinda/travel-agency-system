generator client {
  provider = "prisma-client"
  output   = "../src/generator/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum AgencyRole {
  OWNER
  ADMIN
  STAFF
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum ItineraryStatus {
  DRAFT
  READY
  SENT
  CONFIRMED
  CANCELLED
}

enum ItineraryItemType {
  ACCOMMODATION
  ACTIVITY
  TRANSPORT
  MEAL
  OTHER
}

enum PriceCategory {
  ACCOMMODATION
  TRANSPORT
  ACTIVITIES
  MEALS
  GUIDE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// ==========================================
// USER MODEL
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  platformRole PlatformRole @default(USER)
  isActive     Boolean      @default(true)

  memberships      AgencyMember[]
  createdCustomers Customer[]     @relation("CustomerCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformRole])
}

// ==========================================
// AGENCY MODEL
// ==========================================

model Agency {
  id String @id @default(cuid())

  name String
  slug String @unique

  legalName String?
  email     String?
  phone     String?
  website   String?
  logoUrl   String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  country      String?

  currencyCode String @default("LKR")
  timezone     String @default("Asia/Colombo")

  invoicePrefix     String @default("INV")
  nextInvoiceNumber Int    @default(1)

  status AgencyStatus @default(ACTIVE)

  members     AgencyMember[]
  customers   Customer[]
  itineraries Itinerary[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
}

// ==========================================
// AGENCY MEMBER MODEL
// ==========================================

model AgencyMember {
  id       String     @id @default(cuid())
  agencyId String
  userId   String
  role     AgencyRole @default(STAFF)

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, userId])
  @@index([userId])
  @@index([agencyId, role])
}

// ==========================================
// CUSTOMER MODEL
// ==========================================

model Customer {
  id       String @id @default(cuid())
  agencyId String

  firstName   String
  lastName    String?
  email       String?
  phone       String?
  nationality String?
  notes       String?

  status      CustomerStatus @default(ACTIVE)
  createdById String?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  createdBy User? @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  itineraries Itinerary[]
  invoices    Invoice[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([agencyId])
  @@index([agencyId, email])
  @@index([agencyId, phone])
  @@index([createdById])
}

// ==========================================
// ITINERARY MODEL
// ==========================================

model Itinerary {
  id String @id @default(cuid())

  agencyId   String
  customerId String

  referenceCode String?
  title         String
  destination   String?

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  adults   Int @default(1)
  children Int @default(0)
  infants  Int @default(0)

  status ItineraryStatus @default(DRAFT)

  description String?
  inclusions  String?
  exclusions  String?
  notes       String?

  agency     Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoices   Invoice[]            @relation("InvoiceSourceItinerary")
  days       ItineraryDay[]
  priceItems ItineraryPriceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, referenceCode])
  @@index([agencyId, status])
  @@index([customerId])
  @@index([startDate])
}

// ==========================================
// ITINERARY DAY MODEL
// ==========================================

model ItineraryDay {
  id String @id @default(cuid())

  itineraryId String

  dayNumber Int
  date      DateTime? @db.Date

  title         String?
  description   String?
  accommodation String?

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  items ItineraryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
}

// ==========================================
// ITINERARY ITEM MODEL
// ==========================================

model ItineraryItem {
  id             String            @id @default(cuid())
  itineraryDayId String
  type           ItineraryItemType
  title          String
  description    String?
  location       String?
  startTime      String?
  endTime        String?
  supplierName   String?
  sortOrder      Int               @default(0)

  day        ItineraryDay         @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  priceItems ItineraryPriceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itineraryDayId, sortOrder])
  @@index([type])
}

model ItineraryPriceItem {
  id               String        @id @default(cuid())
  itineraryId      String
  itineraryItemId  String?
  category         PriceCategory
  name             String
  description      String?
  quantity         Decimal       @default(1) @db.Decimal(10, 2)
  unitCost         Decimal       @default(0) @db.Decimal(12, 2)
  unitSellingPrice Decimal       @default(0) @db.Decimal(12, 2)
  currencyCode     String        @default("LKR")

  itinerary     Itinerary      @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  itineraryItem ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itineraryId])
  @@index([itineraryItemId])
  @@index([itineraryId, category])
}

model Invoice {
  id                String  @id @default(cuid())
  agencyId          String
  customerId        String
  sourceItineraryId String?

  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  issueDate DateTime  @db.Date
  dueDate   DateTime? @db.Date

  // Agency information snapshot
  agencyName    String
  agencyEmail   String?
  agencyPhone   String?
  agencyAddress String?
  agencyLogoUrl String?

  // Customer information snapshot
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?

  // Financial information
  currencyCode String  @default("LKR")
  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  tax          Decimal @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal @default(0) @db.Decimal(12, 2)
  amountPaid   Decimal @default(0) @db.Decimal(12, 2)
  balanceDue   Decimal @default(0) @db.Decimal(12, 2)

  notes        String?
  paymentTerms String?

  // Database relationships
  agency          Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customer        Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceItinerary Itinerary? @relation("InvoiceSourceItinerary", fields: [sourceItineraryId], references: [id], onDelete: SetNull)

  items    InvoiceItem[]
  payments InvoicePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, invoiceNumber])
  @@index([agencyId, status])
  @@index([customerId])
  @@index([sourceItineraryId])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  category    String?
  name        String
  description String?

  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @default(0) @db.Decimal(12, 2)

  sortOrder Int @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, sortOrder])
}

model InvoicePayment {
  id        String @id @default(cuid())
  invoiceId String

  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @db.Date
  paymentMethod String?
  reference     String?
  notes         String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([paymentDate])
}
